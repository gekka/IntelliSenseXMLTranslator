<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
	<CheckEolTargetFramework>false</CheckEolTargetFramework>
	  <!--<TargetFramework>net480</TargetFramework>-->
    <TargetFramework>net10.0</TargetFramework>
      <!--<TargetFramework>net6.0-windows</TargetFramework>-->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Gekka.Language.IntelliSenseXMLTranslator</RootNamespace>
    <BaseOutputPath>$(SolutionDir)Output</BaseOutputPath>
     <LangVersion>Latest</LangVersion>

	  <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <NoWarn>1591;1701;1702;8981</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <NoWarn>1591;1701;1702;8981</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Test.cs" />
  </ItemGroup>

    <ItemGroup>
	    <Content Include="..\DataFiles\*.dat" >
		    <LinkBase>DataFiles</LinkBase>
		    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	    </Content>
	    <Content Include="..\DataFiles\*.list" >
		    <LinkBase>DataFiles</LinkBase>
		    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	    </Content>
	    <None Include="Test.cs" />
    </ItemGroup>
	
  <ItemGroup>
    <PackageReference Include="Gekka.MSBuild.targets.SignTool" Version="0.2.9150.31270" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.118" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Translator\Translator.csproj" />
  </ItemGroup>

</Project>
