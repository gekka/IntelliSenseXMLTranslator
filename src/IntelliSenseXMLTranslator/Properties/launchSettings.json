{
  "profiles": {

    "直接指定されたXMLファイルを翻訳 file": {
      "commandName": "Project",
      "commandLineArgs": "/Point BeforeWithBR /Dictionary DataFiles\\Dictionary.ja.dat /DicType text /Translator \"BrowserTranslator\" /OutputDir \"$(SolutionDir)result\" /VersionType Latest   /SkipTokens \"DataFiles\\SkipTokens.list\" \"C:\\Program Files\\dotnet\\packs\\Microsoft.WindowsDesktop.App.Ref\" \"C:\\Program Files\\dotnet\\packs\\Microsoft.NETCore.App.Ref\" ",
      "environmentVariables": {
        "PP_ProjectDir": "$(ProjectDir)",
        "PP_SolutionDir": "$(SolutionDir)"
      }

    },
    "リストファイルで指定のファイルを翻訳 list": {
      "commandName": "Project",
      "commandLineArgs": "/Point BeforeWithBR /Dictionary DataFiles\\Dictionary.ja.dat /DicType text /Translator \"BrowserTranslator\" /OutputDir \"$(SolutionDir)result\" /VersionType Latest  \"DataFiles\\InputXmlFiles.list\" /SkipFiles DataFiles\\SkipFiles.list  /SkipTokens \"DataFiles\\SkipTokens.list\"",
      "environmentVariables": {
        "PP_ProjectDir": "$(ProjectDir)",
        "PP_SolutionDir": "$(SolutionDir)"
      }
    },
    "リストファイルで指定のファイルを翻訳 list 差分": {
      "commandName": "Project",
      "commandLineArgs": "/Point BeforeWithBR /Dictionary DataFiles\\Dictionary.ja.dat /DiffDictionary DataFiles\\Dictionary.ja.diff.dat /DicType text /Translator \"BrowserTranslator\" /OutputDir \"$(SolutionDir)result\" /VersionType Latest  \"DataFiles\\InputXmlFiles.list\" /SkipFiles \"DataFiles\\SkipFiles.list\" /SkipTokens \"DataFiles\\SkipTokens.list\"",
      "environmentVariables": {
        "PP_ProjectDir": "$(ProjectDir)",
        "PP_SolutionDir": "$(SolutionDir)"
      }
    },
    "リストファイルで指定のファイルを翻訳 list (ZIPで圧縮する)": {
      "commandName": "Project",
      "commandLineArgs": "/Point BeforeWithBR /Zip /Dictionary DataFiles\\Dictionary.ja.dat /DicType text /Translator \"BrowserTranslator\" /OutputDir \"$(SolutionDir)result\" /VersionType Latest  \"DataFiles\\InputXmlFiles.list\" /SkipFiles \"DataFiles\\SkipFiles.list\" /SkipTokens \"DataFiles\\SkipTokens.list\"",
      "environmentVariables": {
        "PP_ProjectDir": "$(ProjectDir)",
        "PP_SolutionDir": "$(SolutionDir)"
      }
    },
    "翻訳元ファイルの列挙のみ /Test list": {
      "commandName": "Project",
      "commandLineArgs": "/Test \"DataFiles\\InputXmlFiles.list\" /SkipFiles DataFiles\\SkipFiles.list",
      "environmentVariables": {
        "PP_ProjectDir": "$(ProjectDir)",
        "PP_SolutionDir": "$(SolutionDir)"
      }

    },
    "翻訳元ファイルのXMLの正常チェック /TestXML list": {
      "commandName": "Project",
      "commandLineArgs": "/TestXML \"DataFiles\\InputXmlFiles.list\" /SkipFiles DataFiles\\SkipFiles.list ",
      "environmentVariables": {
        "PP_ProjectDir": "$(ProjectDir)",
        "PP_SolutionDir": "$(SolutionDir)"
      }

    },
    "翻訳元ファイルのXMLの正常チェックDummy /TestXML list": {
      "commandName": "Project",
      "commandLineArgs": "/Translator Dummy /TestXML \"DataFiles\\InputXmlFiles.list\" /SkipFiles DataFiles\\SkipFiles.list /VersionType All",
      "environmentVariables": {
        "PP_ProjectDir": "$(ProjectDir)",
        "PP_SolutionDir": "$(SolutionDir)"
      }

    },
    "ヘルプ表示 /?": {
      "commandName": "Project",
      "commandLineArgs": "/? /xx%E_SolutionDir%",
      "environmentVariables": {
        "PP_ProjectDir": "$(ProjectDir)",
        "PP_SolutionDir": "$(SolutionDir)"
      }
    },
    "IntelliSenseXMLTranslator2": {
      "commandName": "Project",
      "commandLineArgs": "/p BeforeWithBR /d Dictionary.ja.dat /dt text /T BrowserTranslator /O result  \"C:/Users/YAMAMOTO/.nuget/packages/entityframeworkcore.jet\"",
      "environmentVariables": {
        "PP_ProjectDir": "$(ProjectDir)",
        "PP_SolutionDir": "$(SolutionDir)"
      }

    }
  }
